# Copy to .env.runtime on the deployment target. Keep the bearer token in a
# mode-600 file (ideally provisioned from Bitwarden), not in this file.
MUSICOPS_API_TOKEN_FILE=/mnt/user/appdata/musicops/secrets/musicops-api-token
MUSICOPS_PUBLIC_BASE_URL=https://musicops.example.com
MUSICOPS_DATA_DIR=/data
MUSICOPS_LIBRARY_ROOT=/music
MUSICOPS_LIBRARY_PATH=/mnt/user/media/music
TELEGRAM_SESSION_PATH=/mnt/user/appdata/music-manager/scripts
MUSICOPS_TELEGRAM_SESSION_NAME=senyao_userbot
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
MUSICOPS_HOST_PORT=8086
MUSICOPS_METADATA_PROVIDER=musicbrainz
MUSICOPS_METADATA_PROVIDERS=musicbrainz,netease,qq,apple_music,spotify
MUSICOPS_MUSICBRAINZ_API_URL=https://musicbrainz.org/ws/2
MUSICOPS_COVER_ART_API_URL=https://coverartarchive.org
MUSICOPS_METADATA_USER_AGENT=musicops/0.1-personal-library-manager
MUSICOPS_NETEASE_API_URL=https://music.163.com/api
MUSICOPS_QQ_API_URL=https://u.y.qq.com/cgi-bin/musicu.fcg
MUSICOPS_QQ_ALBUM_API_URL=https://c.y.qq.com/v8/fcg-bin/fcg_v8_album_info_cp.fcg
MUSICOPS_APPLE_MUSIC_API_URL=https://api.music.apple.com/v1
MUSICOPS_APPLE_MUSIC_DEVELOPER_TOKEN=
MUSICOPS_APPLE_MUSIC_STOREFRONTS=cn,tw,hk,us
MUSICOPS_SPOTIFY_API_URL=https://api.spotify.com/v1
MUSICOPS_SPOTIFY_ACCOUNTS_API_URL=https://accounts.spotify.com/api
MUSICOPS_SPOTIFY_CLIENT_ID=
MUSICOPS_SPOTIFY_CLIENT_SECRET=
MUSICOPS_SPOTIFY_MARKETS=CN,TW,HK,US
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_PUBLIC_URL=https://music.example.invalid
NAVIDROME_USER=
NAVIDROME_PASSWORD=
MUSIC_STT_ENDPOINT=http://127.0.0.1:8000/v1/audio/transcriptions
MUSIC_STT_MODEL_FAST=deepdml/faster-whisper-large-v3-turbo-ct2
MUSIC_STT_MODEL_BALANCED=deepdml/faster-whisper-large-v3-turbo-ct2
MUSIC_STT_MODEL_ACCURATE=deepdml/faster-whisper-large-v3-turbo-ct2
